# Video files
*.mp4
*.webm
*.mov
*.mkv

# YOLO model
*.pt

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Temporary files / runtime dirs
temp_*
uploads/
downloads/
videos/
output/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Secrets
.env

# Generated metadata
*_metadata.json

# Cache dirs
.cache/
.config/
# Multi-agent Skills
.agents/
.agent/
.claude/
# skills/ holds third-party installs (symlinks); our own published skill is versioned
skills/*
!skills/openshorts/
skills-lock.json


# Cloud env example kept local only (avoid leaking infra hints)
.env.cloud.example
.worktrees

# Session marker written into the repo root as ":memory:.ses" when the suite
# imports the cloud database layer. A colon is an illegal filename character on
# Windows, so leaving it untracked lets it confuse Windows tooling and risks it
# being committed by a `git add .`.
*.ses
